# Contact form → Gmail via Resend (https://resend.com)
# 1. Create a free Resend account and API key
# 2. Copy this file to .env.local and fill in RESEND_API_KEY
# 3. CONTACT_TO_EMAIL is where messages arrive (your Gmail)
# Without RESEND_API_KEY the form falls back to opening the visitor’s mail app.
CONTACT_TO_EMAIL=alamin.badhonn@gmail.com
# RESEND_API_KEY=re_xxxxxxxx
# Free-tier sender (works without a custom domain):
# CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
